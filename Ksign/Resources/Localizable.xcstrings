    "Get access to our secret Discord by donating, where we talk about future updates, betas, and potential ways to make your experience better.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على وصول إلى Discord السري الخاص بنا عبر التبرع، حيث نتحدث عن التحديثات القادمة والنسخ التجريبية وطرق محتملة لتحسين تجربتك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Získejte po podpoření přístup k našemu skrytému Discordu, kde se mluví o dalších aktualizacích, beta verzích a vylepšeních."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte Zugang zu unserem geheimen Discord indem du Spendest! Dort reden wir über zukünftige Updates, Betas und Potenzielle Wege, deine Erfahrung zu Verbessern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get access to our secret Discord by donating, where we talk about future updates, betas, and potential ways to make your experience better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenga acceso a nuestra discordia secreta donando, donde hablamos sobre actualizaciones futuras, betas y formas potenciales de mejorar su experiencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accédez à notre discorde secrète en faisant un don, où nous parlons des futures mises à jour, des bêtas et des moyens potentiels d'améliorer votre expérience."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получите доступ к нашим секретным разногласиям, пожертвовав, где мы говорим о будущих обновлениях, бета -версиях и потенциальных способах улучшить ваш опыт."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağış yaparak gelecekteki güncellemeler, beta sürümleri ve deneyiminizi daha iyi hale getirmenin yolları hakkında konuştuğumuz gizli Discord sunucumuza erişin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận quyền truy cập vào Discord riêng của chúng tôi bằng cách ủng hộ, nơi chúng tôi thảo luận về các bản cập nhật tương lai, phiên bản beta và các cách tiềm năng để cải thiện trải nghiệm của bạn."
          }
        }
      }
    },
