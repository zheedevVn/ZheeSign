    "Enter the password associated with the private key. Leave it blank if theres no password required.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل كلمة المرور المرتبطة بالمفتاح الخاص. اتركه فارغًا إذا لم تكن هناك كلمة مرور مطلوبة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte heslo spojené s privátním klíčem. Když žádné není potřeba, nezadávejte ho."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebe das Passwort ein, das mit dem privaten Schlüssel verknüpft ist. Lasse es leer, wenn kein Passwort erforderlich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the password associated with the private key. Leave it blank if theres no password required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca la contraseña asociada a la llave privada, déjalo en blanco si una contraseña no es necesaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez le mot de passe associé à la clé privée, laissez vide si aucun mot de passe n'est requis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите пароль, связанный с закрытым ключом, оставьте поле пустым, если пароль не требуется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel anahtarla ilişkilendirilmiş parolayı girin. Parola gerekmiyorsa boş bırakın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mật khẩu liên kết với khóa riêng tư. Để trống nếu không yêu cầu mật khẩu."
          }
        }
      }
    },
    "Enter the password for the certificate. Leave it blank if no password is required.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل كلمة مرور الشهادة. اتركه فارغًا إذا لم تكن هناك كلمة مرور مطلوبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebe das Passwort für das Zertifikat ein. Lasse dies frei, falls keines benötigt wird."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mật khẩu của chứng chỉ. Bỏ trống nếu không có mật khẩu"
          }
        }
      }
    },
    "Enter the URL of the website containing the IPA file": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
