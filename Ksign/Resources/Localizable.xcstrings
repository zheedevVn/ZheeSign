    "Choose which library to use for extracting archives. ZIPFoundation is recommended for large files or when Zip is not working.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر المكتبة التي تريد استخدامها لاستخراج الأرشيفات. نوصي باستخدام ZIPFoundation للملفات الكبيرة أو عندما لا يعمل Zip."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, welche Library zum Extrahieren von Archiven benutzt werden sollen. ZIPFoundation wird für größere Dateien empfohlen oder falls Zip nicht funktioniert."
          }
        },
        "vi": {
